<!DOCTYPE html>
<html>
<head>
    <title>Appointments</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <style>
        .page-header {
            font-family: 'Poppins', sans-serif;
            color: #0B1E33;
            padding: 24px 20px 10px 20px;
        }
        .appt-cards {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            padding: 10px 20px 30px 20px;
            font-family: 'Inter', sans-serif;
        }
        .appt-card {
            background: #F7FAFC;
            border-radius: 12px;
            padding: 20px;
            flex: 1 1 260px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
            border-left: 5px solid #2E9CCA;
        }
        .appt-card h3 {
            font-family: 'Poppins', sans-serif;
            font-size: 17px;
            margin: 0 0 10px 0;
            color: #0F6F64;
        }
        .appt-card p {
            font-size: 14px;
            margin: 4px 0;
            color: #4A5568;
        }
        .appt-card .status {
            display: inline-block;
            margin-top: 8px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            background: #E6FFFA;
            color: #0F6F64;
        }
        .appt-card select, .appt-card button {
            margin-top: 8px;
            padding: 6px 10px;
            border-radius: 6px;
            border: 1px solid #CBD5E0;
        }
        .appt-card button {
            background: #2E9CCA;
            color: white;
            border: none;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <h1 class="page-header">All Appointments</h1>

    <div class="appt-cards">
        <% appointments.forEach(a => { %>
            <div class="appt-card">
                <h3><%= a.doctor_name %> <span style="color:#4A5568; font-weight:400;">(<%= a.specialization %>)</span></h3>
                <p><strong>Patient:</strong> <%= a.patient_name %></p>
                <p><strong>Date:</strong> <%= formatDate(a.appointment_date) %></p>
                <p><strong>Time:</strong> <%= a.appointment_time %></p>
                <p><strong>Amount:</strong> ₹<%= a.amount %></p>
                <span class="status"><%= a.status %></span>
                <br>
                <% if (a.payment_status === 'pending') { %>
                    <form action="/markPaid/<%= a.id %>" method="POST">
                        <select name="payment_method" required>
                            <option value="cash">Cash</option>
                            <option value="online">Online</option>
                        </select>
                        <button type="submit">Mark Paid</button>
                    </form>
                <% } else { %>
                    <p><strong>Payment:</strong> <%= a.payment_status %> (<%= a.payment_method %>)</p>
                <% } %>
            </div>
        <% }) %>
    </div>
    <div style="padding: 0 20px 30px 20px;">
        <a href="/book">Book Another Appointment</a> | <a href="/">Back to Home</a>
    </div>
</body>
</html>