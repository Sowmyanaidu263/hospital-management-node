<!DOCTYPE html>
<html>
<head>
    <title>All Bills</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <style>
        .page-header {
            font-family: 'Poppins', sans-serif;
            color: #0B1E33;
            padding: 24px 20px 10px 20px;
        }
        .bill-cards {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            padding: 10px 20px 30px 20px;
            font-family: 'Inter', sans-serif;
        }
        .bill-card {
            background: #F7FAFC;
            border-radius: 12px;
            padding: 20px;
            flex: 1 1 260px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
            border-left: 5px solid #F2704F;
        }
        .bill-card h3 {
            font-family: 'Poppins', sans-serif;
            font-size: 17px;
            margin: 0 0 10px 0;
            color: #0F6F64;
        }
        .bill-card p {
            font-size: 14px;
            margin: 4px 0;
            color: #4A5568;
        }
        .bill-card .total {
            font-size: 16px;
            font-weight: 700;
            color: #0B1E33;
            margin-top: 8px;
        }
        .bill-card .status {
            display: inline-block;
            margin-top: 8px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            background: #FFF0EB;
            color: #F2704F;
        }
        .bill-card a, .bill-card button {
            display: inline-block;
            margin-top: 10px;
            margin-right: 8px;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 13px;
            text-decoration: none;
        }
        .bill-card .invoice-link {
            background: #2E9CCA;
            color: white;
        }
        .bill-card button {
            background: #0F6F64;
            color: white;
            border: none;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <h1 class="page-header">All Bills</h1>

    <div class="bill-cards">
        <% bills.forEach(b => { %>
            <div class="bill-card">
                <h3><%= b.patient_name %></h3>
                <p><strong>Consultation:</strong> ₹<%= b.consultation_charges %></p>
                <p><strong>Medicine:</strong> <%= b.medicine_name || 'N/A' %> (Qty: <%= b.medicine_quantity || 0 %>)</p>
                <p><strong>Medicine Charges:</strong> ₹<%= b.medicine_charges %></p>
                <p><strong>Discount:</strong> ₹<%= b.discount %></p>
                <p class="total">Total: ₹<%= b.total_amount %></p>
                <span class="status"><%= b.payment_status %> (<%= b.payment_method %>)</span>
                <br>
                <a class="invoice-link" href="/invoice/<%= b.id %>" target="_blank">Download Invoice</a>
                <% if (b.payment_status === 'pending') { %>
                    <form action="/markBillPaid/<%= b.id %>" method="POST" style="display:inline">
                        <button type="submit">Mark Paid</button>
                    </form>
                <% } %>
            </div>
        <% }) %>
    </div>
    <div style="padding: 0 20px 30px 20px;">
        <a href="/billing">Create New Bill</a>
    </div>
</body>
</html>