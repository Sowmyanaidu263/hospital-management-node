<!DOCTYPE html>
<html>
<head>
    <title>Hospital Management</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <style>
        .page-header {
            font-family: 'Poppins', sans-serif;
            color: #0B1E33;
            padding: 24px 20px 10px 20px;
        }
        .section-title {
            font-family: 'Poppins', sans-serif;
            color: #0B1E33;
            padding: 20px 20px 0 20px;
        }
        .form-card {
            background: #F7FAFC;
            border-radius: 12px;
            padding: 22px;
            margin: 10px 20px;
            max-width: 420px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
            font-family: 'Inter', sans-serif;
        }
        .form-card label {
            display: block;
            font-weight: 600;
            color: #0F6F64;
            margin: 12px 0 6px 0;
            font-size: 14px;
        }
        .form-card input, .form-card select {
            width: 100%;
            padding: 9px;
            border-radius: 6px;
            border: 1px solid #CBD5E0;
            box-sizing: border-box;
        }
        .form-card button {
            margin-top: 16px;
            padding: 9px 18px;
            border-radius: 6px;
            border: none;
            background: #2E9CCA;
            color: white;
            font-weight: 600;
            cursor: pointer;
        }
        .table-card {
            background: #F7FAFC;
            border-radius: 12px;
            margin: 10px 20px 30px 20px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
            overflow-x: auto;
            font-family: 'Inter', sans-serif;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th {
            background: #0B1E33;
            color: white;
            text-align: left;
            padding: 10px 14px;
            font-family: 'Poppins', sans-serif;
            font-size: 13px;
            white-space: nowrap;
        }
        td {
            padding: 10px 14px;
            border-bottom: 1px solid #E2E8F0;
            font-size: 14px;
            color: #4A5568;
        }
        tr:last-child td {
            border-bottom: none;
        }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <h1 class="page-header">Hospital Management</h1>

    <h2 class="section-title">Add Patient</h2>
    <div class="form-card">
        <form action="/addPatient" method="POST">
            <label>Name</label>
            <input type="text" name="name"/>
            <label>Age</label>
            <input type="number" name="age"/>
            <label>Disease</label>
            <input type="text" name="disease"/>
            <button type="submit">Add Patient</button>
        </form>
    </div>

    <h2 class="section-title">Add Hospital</h2>
    <div class="form-card">
        <form action="/addHospital" method="POST">
            <label>Name</label>
            <input type="text" name="name"/>
            <label>Address</label>
            <input type="text" name="address"/>
            <label>Phone</label>
            <input type="text" name="phone"/>
            <button type="submit">Add Hospital</button>
        </form>
    </div>

    <h2 class="section-title">Add Doctor</h2>
    <div class="form-card">
        <form action="/addDoctor" method="POST">
            <label>Name</label>
            <input type="text" name="name"/>
            <label>Specialization</label>
            <input type="text" name="specialization"/>
            <label>Hospital</label>
            <select name="hospital_id">
                <% hospitals.forEach(h => { %>
                    <option value="<%= h.id %>"><%= h.name %></option>
                <% }) %>
            </select>
            <button type="submit">Add Doctor</button>
        </form>
    </div>

    <h2 class="section-title">Patients</h2>
    <div class="table-card">
        <table>
            <tr><th>ID</th><th>Name</th><th>Age</th><th>Disease</th></tr>
            <% patients.forEach(p => { %>
                <tr>
                    <td><%= p.id %></td>
                    <td><%= p.name %></td>
                    <td><%= p.age %></td>
                    <td><%= p.disease %></td>
                </tr>
            <% }) %>
        </table>
    </div>

    <h2 class="section-title">Hospitals</h2>
    <div class="table-card">
        <table>
            <tr><th>ID</th><th>Name</th><th>Address</th><th>Phone</th></tr>
            <% hospitals.forEach(h => { %>
                <tr>
                    <td><%= h.id %></td>
                    <td><%= h.name %></td>
                    <td><%= h.address %></td>
                    <td><%= h.phone %></td>
                </tr>
            <% }) %>
        </table>
    </div>

    <h2 class="section-title">Doctors</h2>
    <div class="table-card">
        <table>
            <tr><th>ID</th><th>Name</th><th>Specialization</th><th>Hospital</th></tr>
            <% doctors.forEach(d => { %>
                <tr>
                    <td><%= d.id %></td>
                    <td><%= d.name %></td>
                    <td><%= d.specialization %></td>
                    <td><%= d.hospital_name %></td>
                </tr>
            <% }) %>
        </table>
    </div>
</body>
</html>