<!DOCTYPE html>
<html>
<head>
    <title>Find a Hospital</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <style>
        .page-header {
            font-family: 'Poppins', sans-serif;
            color: #0B1E33;
            padding: 24px 20px 10px 20px;
        }
        .search-box {
            background: #F7FAFC;
            border-radius: 12px;
            padding: 20px;
            margin: 10px 20px 24px 20px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
            font-family: 'Inter', sans-serif;
        }
        .search-box input[type="text"] {
            padding: 10px;
            border-radius: 6px;
            border: 1px solid #CBD5E0;
            width: 250px;
            margin-right: 10px;
        }
        .search-box button {
            padding: 10px 18px;
            border-radius: 6px;
            border: none;
            background: #2E9CCA;
            color: white;
            font-weight: 600;
            cursor: pointer;
        }
        .result-cards {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            padding: 0 20px 30px 20px;
            font-family: 'Inter', sans-serif;
        }
        .result-card {
            background: #F7FAFC;
            border-radius: 12px;
            padding: 20px;
            flex: 1 1 260px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
            border-left: 5px solid #0F6F64;
        }
        .result-card h3 {
            font-family: 'Poppins', sans-serif;
            font-size: 16px;
            margin: 0 0 8px 0;
            color: #0F6F64;
        }
        .result-card p {
            font-size: 14px;
            margin: 3px 0;
            color: #4A5568;
        }
        .no-results {
            padding: 0 20px;
            color: #4A5568;
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <h1 class="page-header">Find a Hospital by Disease</h1>

    <div class="search-box">
        <form action="/search" method="POST">
            <label>Enter disease name:</label><br><br>
            <input type="text" name="disease" required placeholder="e.g. diabetes">
            <button type="submit">Search</button>
        </form>
    </div>

    <% if (searched) { %>
        <% if (results.length === 0) { %>
            <p class="no-results">No matching doctors/hospitals found for that disease.</p>
        <% } else { %>
            <div class="result-cards">
                <% results.forEach(r => { %>
                    <div class="result-card">
                        <h3><%= r.name %></h3>
                        <p><strong>Specialization:</strong> <%= r.specialization %></p>
                        <p><strong>Hospital:</strong> <%= r.hospital_name %></p>
                        <p><strong>Address:</strong> <%= r.address %></p>
                        <p><strong>Phone:</strong> <%= r.phone %></p>
                    </div>
                <% }) %>
            </div>
        <% } %>
    <% } %>
</body>
</html>