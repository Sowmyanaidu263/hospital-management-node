<!DOCTYPE html>
<html>
<head>
    <title>Sign Up</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            background: linear-gradient(135deg, #0F6F64, #2E9CCA);
            min-height: 100vh;
            font-family: 'Inter', sans-serif;
        }
        .signup-wrap {
            display: flex;
            justify-content: center;
            padding: 40px 20px;
            box-sizing: border-box;
        }
        .signup-card {
            background: white;
            border-radius: 14px;
            padding: 36px 30px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.15);
        }
        .signup-card h1 {
            font-family: 'Poppins', sans-serif;
            color: #0B1E33;
            font-size: 24px;
            margin: 0 0 20px 0;
        }
        .signup-card h3 {
            font-family: 'Poppins', sans-serif;
            color: #0F6F64;
            font-size: 15px;
            margin: 24px 0 10px 0;
            border-top: 1px solid #E2E8F0;
            padding-top: 16px;
        }
        .signup-card label {
            display: block;
            font-weight: 600;
            color: #0F6F64;
            margin-bottom: 6px;
            font-size: 14px;
        }
        .signup-card input[type="text"],
        .signup-card input[type="email"],
        .signup-card input[type="password"],
        .signup-card input[type="number"],
        .signup-card select,
        .signup-card textarea {
            width: 100%;
            padding: 10px;
            border-radius: 6px;
            border: 1px solid #CBD5E0;
            box-sizing: border-box;
            margin-bottom: 14px;
            font-family: 'Inter', sans-serif;
        }
        .radio-group {
            margin-bottom: 14px;
            font-size: 14px;
            color: #4A5568;
        }
        .radio-group input[type="radio"] {
            accent-color: #2E9CCA;
            margin-right: 4px;
        }
        .signup-card button {
            width: 100%;
            padding: 12px;
            border-radius: 6px;
            border: none;
            background: #2E9CCA;
            color: white;
            font-weight: 600;
            font-size: 15px;
            cursor: pointer;
            margin-top: 6px;
        }
        .signup-card p {
            font-size: 13px;
            color: #4A5568;
            margin: 14px 0 0 0;
        }
        .signup-card a {
            color: #2E9CCA;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="signup-wrap">
        <div class="signup-card">
            <h1>Sign Up</h1>
            <form action="/signup" method="POST">
                <label>Full Name</label>
                <input type="text" name="name" required>

                <label>Email</label>
                <input type="email" name="email" required>

                <label>Password</label>
                <input type="password" name="password" required>

                <label>Role</label>
                <select name="role" required>
                    <option value="patient">Patient</option>
                    <option value="doctor">Doctor</option>
                    <option value="admin">Admin</option>
                </select>

                <h3>Patient Details (if signing up as patient)</h3>

                <label>Age</label>
                <input type="number" name="age">

                <label>Gender</label>
                <div class="radio-group">
                    <input type="radio" name="gender" value="male" id="genMale"><label for="genMale" style="display:inline; font-weight:400;">Male</label>
                    <input type="radio" name="gender" value="female" id="genFemale" style="margin-left:10px;"><label for="genFemale" style="display:inline; font-weight:400;">Female</label>
                    <input type="radio" name="gender" value="other" id="genOther" style="margin-left:10px;"><label for="genOther" style="display:inline; font-weight:400;">Other</label>
                </div>

                <label>Blood Group</label>
                <select name="blood_group">
                    <option value="">-- Select --</option>
                    <option value="A+">A+</option>
                    <option value="A-">A-</option>
                    <option value="B+">B+</option>
                    <option value="B-">B-</option>
                    <option value="O+">O+</option>
                    <option value="O-">O-</option>
                    <option value="AB+">AB+</option>
                    <option value="AB-">AB-</option>
                </select>

                <label>Phone Number</label>
                <input type="text" name="phone">

                <label>Address</label>
                <input type="text" name="address">

                <label>Emergency Contact Number</label>
                <input type="text" name="emergency_contact">

                <label>Medical History</label>
                <textarea name="medical_history" rows="3"></textarea>

                <button type="submit">Register</button>
            </form>
            <p>Already have an account? <a href="/login">Login</a></p>
        </div>
    </div>
</body>
</html>