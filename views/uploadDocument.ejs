<!DOCTYPE html>
<html>
<head>
    <title>Upload Document</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <style>
        .page-header {
            font-family: 'Poppins', sans-serif;
            color: #0B1E33;
            padding: 24px 20px 10px 20px;
        }
        .form-card {
            background: #F7FAFC;
            border-radius: 12px;
            padding: 24px;
            margin: 10px 20px 24px 20px;
            max-width: 420px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
            font-family: 'Inter', sans-serif;
        }
        .form-card label {
            display: block;
            font-weight: 600;
            color: #0F6F64;
            margin: 14px 0 6px 0;
        }
        .form-card input[type="file"] {
            width: 100%;
            padding: 10px;
            border-radius: 6px;
            border: 1px solid #CBD5E0;
            box-sizing: border-box;
            background: white;
        }
        .form-card button {
            margin-top: 20px;
            padding: 10px 20px;
            border-radius: 6px;
            border: none;
            background: #2E9CCA;
            color: white;
            font-weight: 600;
            cursor: pointer;
        }
        .message {
            background: #E6FFFA;
            color: #0F6F64;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 14px;
            margin: 10px 20px 0 20px;
            max-width: 380px;
            font-family: 'Inter', sans-serif;
        }
        .links {
            padding: 20px;
            font-family: 'Inter', sans-serif;
        }
        .links a {
            color: #2E9CCA;
            margin-right: 10px;
        }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <h1 class="page-header">Upload Medical Document / Lab Report</h1>

    <% if (message) { %>
        <p class="message"><strong><%= message %></strong></p>
    <% } %>

    <div class="form-card">
        <form action="/uploadDocument" method="POST" enctype="multipart/form-data">
            <label>Select File</label>
            <input type="file" name="document" required>
            <button type="submit">Upload</button>
        </form>
    </div>

    <div class="links">
        <a href="/patientProfile">Back to Profile</a> | <a href="/">Back to Home</a>
    </div>
</body>
</html>