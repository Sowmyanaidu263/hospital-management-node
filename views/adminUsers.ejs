<!DOCTYPE html>
<html>
<head>
    <title>All Users</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <style>
        .page-header {
            font-family: 'Poppins', sans-serif;
            color: #0B1E33;
            padding: 24px 20px 10px 20px;
        }
        .table-card {
            background: #F7FAFC;
            border-radius: 12px;
            margin: 10px 20px 30px 20px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
            overflow: hidden;
            font-family: 'Inter', sans-serif;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th {
            background: #0B1E33;
            color: white;
            text-align: left;
            padding: 12px 14px;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
        }
        td {
            padding: 12px 14px;
            border-bottom: 1px solid #E2E8F0;
            font-size: 14px;
            color: #4A5568;
        }
        tr:last-child td {
            border-bottom: none;
        }
        .role-badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            background: #E6FFFA;
            color: #0F6F64;
        }
        select {
            padding: 6px 8px;
            border-radius: 6px;
            border: 1px solid #CBD5E0;
        }
        td button {
            padding: 6px 12px;
            border-radius: 6px;
            border: none;
            background: #2E9CCA;
            color: white;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            margin-left: 6px;
        }
    </style>
</head>
<body>
    <%- include('partials/nav') %>

    <h1 class="page-header">All Users</h1>

    <div class="table-card">
        <table>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Change Role</th>
            </tr>
            <% users.forEach(u => { %>
                <tr>
                    <td><%= u.id %></td>
                    <td><%= u.name %></td>
                    <td><%= u.email %></td>
                    <td><span class="role-badge"><%= u.role %></span></td>
                    <td>
                        <form action="/admin/changeRole/<%= u.id %>" method="POST" style="display:flex; align-items:center;">
                            <select name="role">
                                <option value="patient" <%= u.role === 'patient' ? 'selected' : '' %>>Patient</option>
                                <option value="doctor" <%= u.role === 'doctor' ? 'selected' : '' %>>Doctor</option>
                                <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                            </select>
                            <button type="submit">Update</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </table>
    </div>
</body>
</html>